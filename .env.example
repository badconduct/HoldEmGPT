HOST=127.0.0.1
PORT=3083
# local: independent server strategy bots, no account needed
# api / codex / chatgpt: independent model calls; failure pauses play with Retry
AI_MODE=local
AI_API_FORMAT=chat
AI_URL=https://your-provider.example/v1/chat/completions
AI_MODEL=your-model
AI_TOKEN=
# Optional server-side credential file (takes precedence over AI_TOKEN):
# AI_TOKEN_FILE=/run/secrets/ai-token
# Optional authenticated startup check; omitted for providers without /models:
# AI_MODELS_URL=https://your-provider.example/v1/models
AI_TIMEOUT_MS=60000
# Optional storage and reverse proxy settings:
# SAVE_DIR=/app/data/saves
# PUBLIC_ORIGIN=https://poker.example.com
# COOKIE_SECURE=true
# For installed Codex CLI with ChatGPT login (AI_MODE=codex also works):
# AI_MODE=chatgpt
# AI_MODEL=default
# AI_TIMEOUT_MS=180000
# CODEX_COMMAND=codex
# Optional full path to the npm JS entry; bypasses Windows .cmd shims:
# CODEX_JS_PATH=
# Optional effort supported by the selected model, for example low:
# AI_REASONING=
# Optional CLI authentication/state directory; must be writable by the server:
# CODEX_HOME=/home/poker/.codex
